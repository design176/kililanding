        "btn-mono-light-active-bottom": { "value": "#ededed", "variable": "--btn-mono-light-active-bottom" },
        "btn-mono-light-border": { "value": "#ffffff", "variable": "--btn-mono-light-border" },
        "btn-mono-light-ring": { "value": "#ededed", "variable": "--btn-mono-light-ring" },
        "btn-mono-light-text": { "value": "#18181b", "variable": "--btn-mono-light-text" }
