        "brand-soft": { "value": "#ECFDF3", "variable": "--color-brand-soft" },
        "brand-soft-hover": { "value": "#D1FADF", "variable": "--color-brand-soft-hover" },
        "brand-soft-active": { "value": "#ABEFC6", "variable": "--color-brand-soft-active" },
        "brand-border": { "value": "#ABEFC6", "variable": "--color-brand-border" },
