        "text-tertiary": { "value": "#475467", "variable": "--color-text-tertiary" },
        "text-muted": { "value": "#667085", "variable": "--color-text-muted" },
        "text-subtle": { "value": "#98A2B3", "variable": "--color-text-subtle" },
        "text-disabled": { "value": "#B2B8C2", "variable": "--color-text-disabled" },
        "text-inverse": { "value": "#FFFFFF", "variable": "--color-text-inverse" }
