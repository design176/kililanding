{
  "version": 2,
  "components": {
    "Button": {
      "props": {
        "variant": {
          "type": "enum",
          "values": ["primary", "secondary", "ghost", "destructive", "accent"],
          "default": "primary",
          "class_map": {
            "primary": "primary",
            "secondary": "secondary",
            "ghost": "ghost",
            "destructive": "destructive",
            "accent": "accent"
          }
        },
        "size": {
          "type": "enum",
          "values": ["sm", "md", "lg", "xl"],
          "default": "md",
          "class_map": {
            "sm": "sm",
            "md": "md",
            "lg": "lg",
            "xl": "xl"
          }
        },
        "pill": {
          "type": "boolean",
          "default": false,
          "class_map": { "true": "pill" }
        },
        "disabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "Badge": {
      "props": {
        "tone": {
          "type": "enum",
          "values": ["neutral", "brand", "success", "warning", "danger", "info", "purple", "amber"],
          "default": "neutral",
          "class_map": {
            "neutral": "neutral",
            "brand": "brand",
            "success": "success",
            "warning": "warning",
            "danger": "danger",
            "info": "info",
            "purple": "purple",
            "amber": "amber"
          }
        },
        "dot": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "Tabs": {
      "props": {
        "size": {
          "type": "enum",
          "values": ["sm", "md", "lg"],
          "default": "md"
        },
        "activeVariant": {
          "type": "enum",
          "values": ["primary", "secondary"],
          "default": "primary",
          "description": "Which Button variant the currently-active tab renders as. Inactive tabs always render as ghost."
        },
        "pill": {
          "type": "boolean",
          "default": false,
          "class_map": { "true": "trackPill" },
          "description": "Fully-rounded pill shape for the track and its tabs, used on the marketing pages."
        }
      }
    },
    "Skeleton": {
      "props": {
        "variant": {
          "type": "enum",
          "values": ["text", "rect", "circle"],
          "default": "rect",
          "class_map": {
            "text": "text",
            "rect": "rect",
            "circle": "circle"
          }
        }
      }
    },
    "PlatformPicker": {
      "props": {
        "value": {
          "type": "enum",
          "values": ["x", "instagram", "tiktok", "linkedin", "github", "youtube"],
          "default": "x",
          "description": "Which social platform icon is shown as selected in the get-started signup form's platform dropdown."
        },
        "disabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "SiteClosingCta": {
      "props": {
        "body": {
          "type": "string",
          "description": "Optional subhead paragraph shown under the heading in the black closing CTA panel."
        }
      }
    },
    "SignupForm": {
      "state": {
        "status": {
          "type": "enum",
          "values": ["idle", "loading", "success", "error"],
          "default": "idle",
          "description": "Drives the submit button's label ('Send' / 'Sending…' / 'Sent'), whether inputs are disabled, and the note text's color below the form."
        },
        "siteError": {
          "type": "boolean",
          "default": false,
          "description": "Shows the product-url input's error (red) border."
        },
        "contactError": {
          "type": "boolean",
          "default": false,
          "description": "Shows the email/handle input's error (red) border."
        }
      }
    },
    "HomeDemoBand": {
      "state": {
        "active": {
          "type": "enum",
          "values": ["chat", "mcp", "creative", "web"],
          "default": "chat",
          "description": "Which pill in the notch tab strip is highlighted (white, with the timer ring) and which placeholder screenshot is shown below it. Auto-advances every 4s, or on click."
        }
      }
    }
  },
  "tokens": {
    "colors": {
      "background": {
        "bg": { "value": "#FFFFFF", "variable": "--color-bg" },
        "bg-subtle": { "value": "#FAFAFA", "variable": "--color-bg-subtle" },
        "bg-muted": { "value": "#F7F7F8", "variable": "--color-bg-muted" }
      },
      "surface": {
        "surface-1": { "value": "#FCFCFD", "variable": "--color-surface-1" },
        "surface-2": { "value": "#F9FAFB", "variable": "--color-surface-2" },
        "surface-3": { "value": "#F2F4F7", "variable": "--color-surface-3" },
        "surface-4": { "value": "#EAECF0", "variable": "--color-surface-4" },
        "surface-raised": { "value": "#FFFFFF", "variable": "--color-surface-raised" },
        "surface-overlay": { "value": "#FFFFFF", "variable": "--color-surface-overlay" }
      },
      "interactive": {
