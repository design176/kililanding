      "3": { "value": "12px" },
      "4": { "value": "16px" },
      "6": { "value": "24px" },
      "8": { "value": "32px" },
      "12": { "value": "48px" },
      "14": { "value": "56px" },
      "18": { "value": "74px" },
      "24": { "value": "96px" }
    },
    "radii": {
      "sm": { "value": "6px", "description": "Button size=sm" },
      "md": { "value": "7px", "description": "Button size=md" },
      "lg": { "value": "8px", "description": "Button size=lg" },
      "xl": { "value": "9px", "description": "Button size=xl" },
      "card": { "value": "12px", "description": "Panels, cards, cell grids across the marketing pages and home sections" },
      "frame": { "value": "20px", "description": "Screenshot/demo frame top corners" },
      "notch": { "value": "24px", "description": "Home hero tab-strip notch bottom corners" },
      "pill": { "value": "999px", "description": "Button pill=true, Badge, Tabs pill=true" }
    },
    "borderWidths": {
      "hairline": { "value": "1px" },
      "thick": { "value": "1.5px", "description": "Button secondary/primary mono-light border" }
    },
    "shadows": {
      "xs": { "value": "0 1px 2px rgba(16, 24, 40, 0.05)", "variable": "--shadow-xs" },
      "sm": { "value": "0 1px 3px rgba(16, 24, 40, 0.08), 0 1px 2px rgba(16, 24, 40, 0.04)", "variable": "--shadow-sm" },
      "md": { "value": "0 4px 8px -2px rgba(16, 24, 40, 0.10), 0 2px 4px -2px rgba(16, 24, 40, 0.06)", "variable": "--shadow-md" },
      "lg": { "value": "0 12px 24px -8px rgba(16, 24, 40, 0.14)", "variable": "--shadow-lg" }
    },
    "typography": {
      "font-heading": { "value": "\"Satoshi\", sans-serif", "variable": "--font-heading" },
      "font-body": { "value": "var(--font-work-sans), \"Work Sans\", sans-serif", "variable": "--font-body" },
